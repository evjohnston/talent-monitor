---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TrackWorkforceEntry } from "../dashboards/TrackWorkforceEntry.tsx";
import { buildTrackContext, formatGenerated } from "../lib/buildContext.ts";
import { loadTalentData } from "../lib/loadTalentData.ts";

const data = loadTalentData();
const ctx = buildTrackContext(data, "workforce-entry");
---
<BaseLayout active="workforce-entry" generated={formatGenerated(data)}>
  <TrackWorkforceEntry ctx={ctx} client:load />
</BaseLayout>
