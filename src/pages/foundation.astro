---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TrackFoundation } from "../dashboards/TrackFoundation.tsx";
import { buildTrackContext, formatGenerated } from "../lib/buildContext.ts";
import { loadTalentData } from "../lib/loadTalentData.ts";

const data = loadTalentData();
const ctx = buildTrackContext(data, "foundation");
---
<BaseLayout active="foundation" generated={formatGenerated(data)}>
  <TrackFoundation ctx={ctx} client:load />
</BaseLayout>
