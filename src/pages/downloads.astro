---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Downloads } from "../dashboards/Downloads.tsx";
import { buildDashboardContext, formatGenerated } from "../lib/buildContext.ts";
import { loadTalentData } from "../lib/loadTalentData.ts";

const data = loadTalentData();
const ctx = buildDashboardContext(data);
---
<BaseLayout active="downloads" generated={formatGenerated(data)}>
  <Downloads ctx={ctx} client:load />
</BaseLayout>
