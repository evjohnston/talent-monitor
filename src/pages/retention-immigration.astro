---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TrackRetentionImmigration } from "../dashboards/TrackRetentionImmigration.tsx";
import { buildDashboardContext, formatGenerated } from "../lib/buildContext.ts";
import { loadTalentData } from "../lib/loadTalentData.ts";

const data = loadTalentData();
const ctx = buildDashboardContext(data);
---
<BaseLayout active="retention-immigration" generated={formatGenerated(data)}>
  <TrackRetentionImmigration ctx={ctx} client:load />
</BaseLayout>
