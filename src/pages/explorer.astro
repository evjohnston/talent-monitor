---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Explorer } from "../dashboards/Explorer.tsx";
import { buildDashboardContext, formatGenerated } from "../lib/buildContext.ts";
import { loadTalentData } from "../lib/loadTalentData.ts";

const data = loadTalentData();
const ctx = buildDashboardContext(data);
---
<BaseLayout active="explorer" generated={formatGenerated(data)}>
  <Explorer exhibits={ctx.exhibits} client:load />
</BaseLayout>
