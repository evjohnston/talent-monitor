---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TrackGraduateTraining } from "../dashboards/TrackGraduateTraining.tsx";
import { buildTrackContext, formatGenerated } from "../lib/buildContext.ts";
import { loadTalentData } from "../lib/loadTalentData.ts";

const data = loadTalentData();
const ctx = buildTrackContext(data, "graduate-training");
---
<BaseLayout active="graduate-training" generated={formatGenerated(data)}>
  <TrackGraduateTraining ctx={ctx} client:load />
</BaseLayout>
