{
  "name": "global-talent-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Global Talent Monitor — a pipeline view of US STEM talent, from foundation through degree production, graduate training, workforce entry, retention/immigration, and research output.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsc -b --noEmit && astro build",
    "preview": "astro preview",
    "import-talent-charts": "tsx scripts/import-talent-charts.ts",
    "gen-continent-map": "tsx scripts/gen-continent-map.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:interaction": "playwright test tests/interaction.spec.ts",
    "test:visual": "playwright test tests/visual-regression.spec.ts",
    "generate-downloads": "tsx scripts/generate-downloads.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "astro": "^7.1.5",
    "d3-geo": "^3.1.1",
    "d3-sankey": "^0.12.3",
    "i18n-iso-countries": "^7.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^4.0.0-beta.6",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/archiver": "^8.0.0",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-simple-maps": "^3.0.6",
    "archiver": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "world-countries": "^5.1.0"
  }
}
