{
  "name": "global-talent-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Global Talent Monitor — a pipeline view of U.S. STEM talent, from foundation through degree production, graduate training, workforce entry, retention/immigration, and research output.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "import-talent-charts": "tsx scripts/import-talent-charts.ts",
    "gen-continent-map": "tsx scripts/gen-continent-map.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-sankey": "^0.12.3",
    "i18n-iso-countries": "^7.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^4.0.0-beta.6",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "world-countries": "^5.1.0"
  }
}
