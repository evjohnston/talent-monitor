node_modules
dist
# Astro's generated-types/content cache (astro.config.mjs) — build output,
# not source, same treatment as dist/.
.astro
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json

# tsc -b's incremental build cache — per-machine/per-TS-version, not meant
# to be version controlled (was tracked before this cleanup; untracked here
# since it just adds a noisy diff on every build with no real benefit).
*.tsbuildinfo

# public/data/talent.json IS committed to main (2026-07-28 talent-monitor
# rebuild) — unlike the old quantum/AI verticals' nightly-fetched data,
# there's no live source behind it to protect a human's `git pull` from;
# see CLAUDE.md's "Ingestion" section. The `data` branch this repo used to
# split fetch output onto is now dormant, not deleted, in case any of that
# history is ever needed again.

# Generated output from one-off research scripts (e.g. form-d-sector-
# tracker.ts) — real data, but it's a local analysis artifact regenerated
# on demand, not something the app or CI reads.
output/

# Raw S&P Capital IQ Pro exports — never commit these. S&P's data
# licensing does not permit redistributing raw platform exports, unlike
# the free public-source data (SEC/NSF/OECD) this repo otherwise commits.
# The import scripts (scripts/import-capiq-*.ts) read one of these locally
# and write only the derived, restated figures into the committed
# data/capiq/*.ts files — those are fine to commit, this pattern is not.
# Broad on purpose (any .xlsx at the repo root, whatever the export
# happens to be named that day — "SPGlobal_Export_*.xlsx" alone already
# missed a manually-renamed "AI-S&P.xlsx"/"Quantum-S&P.xlsx" pair once).
SPGlobal_Export_*.xlsx
/*.xlsx
# Same rule, folder form: ciq_data/ holds raw multi-field Transactions
# exports for the Python classification pipeline (scripts/ciq_pipeline/) —
# never commit these either.
ciq_data/

# Python venv for the CapIQ classification pipeline (pandas/openpyxl/
# sentence-transformers) — separate from the Node toolchain the rest of
# this repo uses, kept local like node_modules.
.venv-ciq/
__pycache__/

# Pipeline output (per-field tagged xlsx, combined parquet, summary.md) —
# real derived data, but large (10 fields, full deal text + embeddings)
# and not yet decided whether/how it feeds the app. Local-only for now,
# same treatment as output/ (form-d-sector-tracker.ts).
ciq_output/
.embed_cache/

# talent_charts/ (the R project behind "The Great Talent Competition,"
# absorbed as plain tracked files 2026-07-28 — see CLAUDE.md) has its own
# RStudio session-state dumps, not source. .DS_Store already covered above.
talent_charts/.RData
talent_charts/.RDataTmp
talent_charts/.Rhistory

# writing/ — the report's own Word draft manuscripts (multiple versions,
# internal-review filenames). This repo deploys publicly to GitHub Pages;
# unpublished draft content with review history stays local-only,
# deliberately never committed, same "don't publish what isn't meant to be
# public" instinct as the CapIQ raw-export rule above.
writing/
# Same treatment for reference docs dropped at the repo root rather than
# into writing/ — a draft manuscript copy and the (likely licensed/
# internal) Hoover style guide. Source-of-truth reading material for the
# overhaul, never meant to be published in a public repo.
/Talent Report*.docx
/Hoover Style Guide*.pdf
